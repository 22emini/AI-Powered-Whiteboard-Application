PORT=xxxx
DATABASE_URL=xxxxxxxc
JWT_SECRET=xxxxxxx
GEMINI_API_KEY=xxxxxxxxxxxxx

# Password reset emails:
# Recommended for Render Free tier (Render blocks SMTP ports 25, 465, 587):
# Get a free key at https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxx

# Alternatively, SMTP (works in local development):
FRONTEND_URL=http://localhost:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="Syntheboard <you@gmail.com>"

# Image uploads (Cloudinary - Recommended for production CDN storage):
# Free plan (no credit card needed): https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

